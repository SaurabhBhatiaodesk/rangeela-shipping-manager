// Local / shopify app dev uses SQLite.
// On Heroku: set provider to postgresql + DATABASE_URL from heroku-postgresql addon
// (see docs/PHASE-0.md). Migration SQL for Postgres is under prisma/migrations/.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model ShopKlaviyoSettings {
  shop                       String   @id
  pieceMadeTemplateId        String   @default("")
  leavingForCanadaTemplateId String   @default("")
  arrivedInCanadaTemplateId  String   @default("")
  thursdayTemplateId         String   @default("")
  pieceMadeLabel             String   @default("")
  leavingForCanadaLabel      String   @default("")
  arrivedInCanadaLabel       String   @default("")
  depositFulfilledLabel      String   @default("")
  depositFulfilledDoneLabel  String   @default("")
  pieceMadeTag               String   @default("")
  leavingForCanadaTag        String   @default("")
  arrivedInCanadaTag         String   @default("")
  pieceMadeEmailSentTag      String   @default("")
  leavingEmailSentTag        String   @default("")
  arrivedEmailSentTag        String   @default("")
  updatedAt                  DateTime @updatedAt
}
